# Server Configuration
PORT=3005
NODE_ENV=development

# Gemini API Configuration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API Configuration
# Get your API key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ElevenLabs Character Voice IDs (default public library voices)
# Athena: calm, measured, intellectual female (Rachel)
ELEVENLABS_VOICE_ATHENA=21m00Tcm4TlvDq8ikWAM
# Poseidon: deep, gravelly, dramatic male (Drew)
ELEVENLABS_VOICE_POSEIDON=VR6AewLTigWG4xSOukaG
# Hermes: witty, youthful, quick male (Antoni)
ELEVENLABS_VOICE_HERMES=ErXwobaYiN019PkySvjV
# Odysseus: warm, reflective, mature male survivor (Bill)
ELEVENLABS_VOICE_ODYSSEUS=pqHfZKP75CvOlQylNhV4
# Oracle: neutral, warm prophetic female (Elli)
ELEVENLABS_VOICE_ORACLE=MF3mGyEYCl7XYWbV9V6O

# Audio Cache & Demo Configuration
ENABLE_AUDIO_CACHE=true
AUDIO_CACHE_DIR=.cache/audio
